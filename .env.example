# Copiar para .env e preencher (o .env NUNCA vai para o GitHub).
# Gerar valores aleatórios com:  ./scripts/gerar_env.sh

# Credenciais do MinIO (utilizador root dos 4 nós)
MINIO_ROOT_USER=bluegarden
MINIO_ROOT_PASSWORD=mudar-esta-password
MINIO_BUCKET=ficheiros

# Segredo para assinar os JWT (partilhado pelos 3 backends)
JWT_SEGREDO=mudar-este-segredo
JWT_VALIDADE_MINUTOS=120

# Chave Fernet para cifrar os ficheiros antes de irem para o MinIO.
# Se se perder, os ficheiros guardados deixam de poder ser decifrados!
FERNET_CHAVE=gerar-com-o-script

# Limite de tamanho de upload (MB) — tem de bater com client_max_body_size no nginx
TAMANHO_MAXIMO_MB=50

# Abaixo deste valor a IA põe o ficheiro em "Por rever"
LIMIAR_CONFIANCA=0.6
